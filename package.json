{
  "name": "loftet-isolated-atproto-sandbox",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@atproto/dev-env": "0.7.22",
    "zod": "4.6.7"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "logs": "docker compose logs --tail=50 -f atproto",
    "verify": "./verify.sh",
    "test": "node dist/smoke-test.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "preverify": "pnpm run build",
    "check": "pnpm run format:check && pnpm run typecheck",
    "format": "prettier --write *.ts",
    "format:check": "prettier --check *.ts"
  },
  "engines": {
    "node": ">=24.17 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "prettier": "3.10.1"
  }
}
